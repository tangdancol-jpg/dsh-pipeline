{
  "name": "dsh-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "多对话 AI 协作开发流水线：主对话只调度不干活，编写/测试/审核三权分立。把「分档编排 → 结构化交接物 → 状态机 → 审核 OK 才关单」固化成可拦截的机制，而不是靠角色自觉。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pipeline",
    "multi-agent",
    "separation-of-powers",
    "gate",
    "handoff",
    "state-machine"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./lib/*": "./lib/*",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "locale",
    "icon.svg",
    "presets",
    "tests",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "ARCHITECTURE.md",
    "REPORT.md",
    "install.ps1",
    "rollback.ps1"
  ],
  "icon": "./icon.svg",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "selftest": "node tests/selftest.mjs",
    "acceptance": "node tests/acceptance.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/generated/pipeline-presets.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
